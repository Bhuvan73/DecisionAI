# Copy this file to ".env" and put your real key in. NEVER commit .env (it is in .gitignore).

# Required: SerpApi key (https://serpapi.com, Google Shopping API). The key stays on the server.
SERPAPI_KEY=your_serpapi_api_key

# Keep false so failed live searches never show sample products as real results.
ALLOW_DEMO_FALLBACK=false

# Cache repeated searches (minutes). Longer = fewer API calls = your free allowance lasts longer.
CACHE_ENABLED=true
CACHE_TTL_MINUTES=180

# Optional: AI answers from any OpenAI-compatible API. Without it, rule-based answers are used.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# Optional extras
AMAZON_AFFILIATE_TAG=
SERPER_API_KEY=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
PRODUCT_API_URL=
PRODUCT_API_KEY=
PRODUCT_API_FIELD_MAP=

# Server / storage (set HOST=0.0.0.0 and DB_PATH for deployment)
HOST=127.0.0.1
PORT=8000
DB_PATH=
CONTACT_EMAIL=
ALERT_CHECK_MINUTES=0
LOG_LEVEL=INFO
COUNTRY=IN
CURRENCY=INR
